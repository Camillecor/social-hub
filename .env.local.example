# Copy this file to .env.local and fill in your real Supabase credentials.
# You can find them in your Supabase dashboard: Project Settings → API.
#
# The dashboard runs fine WITHOUT these — leave the placeholders and the app
# just shows empty stats. Fill them in when you want live data + auth.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
